{
  "sourceLanguage": "en",
  "strings": {
    "app.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakeibo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家計簿"
          }
        }
      }
    },
    "camera.denied.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To scan receipts, allow camera access for Kakeibo in Settings. You can still choose a photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートを撮影するには、設定でKakeiboのカメラへのアクセスを許可してください。写真から選ぶこともできます。"
          }
        }
      }
    },
    "camera.denied.notNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はしない"
          }
        }
      }
    },
    "camera.denied.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        }
      }
    },
    "camera.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスがオフです"
          }
        }
      }
    },
    "ledger.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a receipt to add your first expense."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートをスキャンして最初の支出を追加しましょう。"
          }
        }
      }
    },
    "ledger.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No expenses yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ支出がありません"
          }
        }
      }
    },
    "scan.action.photo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真から選ぶ"
          }
        }
      }
    },
    "scan.action.scan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan receipt"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートを撮影"
          }
        }
      }
    },
    "scan.error.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "scan.error.noText.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the photo shows a receipt and is in focus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートが写っていて、ピントが合っているか確認してください。"
          }
        }
      }
    },
    "scan.error.noText.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text found"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字が見つかりませんでした"
          }
        }
      }
    },
    "scan.error.tryAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試す"
          }
        }
      }
    },
    "scan.error.unreadable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again with the whole receipt in view and good light."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシート全体が写るように、明るい場所でもう一度お試しください。"
          }
        }
      }
    },
    "scan.error.unreadable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read this image"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像を読み取れませんでした"
          }
        }
      }
    },
    "scan.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing leaves your iPhone. Works offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはiPhoneの外に出ません。オフラインで動作します。"
          }
        }
      }
    },
