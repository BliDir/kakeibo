      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access for Kakeibo in iOS Settings to scan receipts. You can still choose a photo or type an expense in yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートを撮影するには、iOSの設定でKakeiboのカメラへのアクセスを許可してください。写真から選ぶことも、手入力することもできます。"
          }
        }
      }
    },
    "camera.denied.openSettings": {
      "extractionState": "manual",
      "localizations": {
