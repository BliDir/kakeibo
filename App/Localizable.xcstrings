{
  "sourceLanguage": "en",
  "strings": {
    "budget.alert.100.title %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s budget reached"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の予算に達しました"
          }
        }
      }
    },
    "budget.alert.80.title %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "80%% of %@'s budget used"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の予算の80%%に達しました"
          }
        }
      }
    },
    "budget.alert.dismiss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
