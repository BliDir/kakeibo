          "stringUnit": {
            "state": "translated",
            "value": "今週使える金額 · %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "budget.week.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available this week"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週使える金額"
          }
        }
      }
    },
    "budget.week.usedUp %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s budget is used up. The next month starts %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の予算を使い切りました。次の月は%2$@からです。"
          }
        }
      }
    },
    "camera.denied.choosePhoto": {
      "extractionState": "manual",
      "localizations": {
