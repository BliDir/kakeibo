    "camera.denied.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To scan receipts, allow camera access for Kakeibo in Settings. You can still choose a photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートを撮影するには、設定でKakeiboのカメラへのアクセスを許可してください。写真から選ぶこともできます。"
          }
        }
      }
    },
