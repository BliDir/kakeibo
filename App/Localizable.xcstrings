    "budget.amount.help %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole yen. Counts every expense recorded in %@, scanned or typed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "円単位で入力します。%@に記録したすべての支出（読み取り・手入力）が対象です。"
          }
        }
      }
    },
    "budget.amount.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MONTHLY LIMIT · 月の上限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の上限 · MONTHLY LIMIT"
          }
        }
      }
    },
    "budget.closed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past month · view only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の月 · 閲覧のみ"
          }
        }
      }
    },
    "budget.cta.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set budget"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算を設定"
          }
        }
      }
    },
    "budget.cta.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what's left this month and how much you can spend this week."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の残りと、今週使える金額がわかります。"
          }
        }
      }
    },
    "budget.cta.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a monthly budget"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の予算を設定しましょう"
          }
        }
      }
    },
    "budget.edit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
