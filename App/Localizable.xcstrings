    "budget.saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the budget. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算を保存できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "budget.saved": {
      "extractionState": "manual",
      "localizations": {
