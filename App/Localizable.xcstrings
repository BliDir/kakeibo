    "budget.sheet.title %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ budget"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の予算"
          }
        }
      }
    },
    "budget.template.off %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: this budget applies to %@ only. You'll set each month yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ：%@だけの予算です。毎月ご自身で設定します。"
          }
        }
      }
    },
    "budget.template.on %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: %1$@ and later start with %2$@. Months you've already set stay as they are."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン：%1$@以降は%2$@から始まります。設定済みの月は変わりません。"
          }
        }
      }
    },
    "budget.template.on.noAmount %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: %@ and later start with the amount above. Months you've already set stay as they are."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン：%@以降は上の金額から始まります。設定済みの月は変わりません。"
          }
        }
      }
    },
    "budget.template.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this amount for future months"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "来月以降もこの金額を使う"
          }
        }
      }
    },
    "budget.week.days %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日間"
          }
        }
      }
    },
    "budget.week.explain %lld %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's left, spread over the %1$lld days remaining in %2$@. It updates as you spend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの予算を%2$@の残り%1$lld日で割った目安です。支出に合わせて変わります。"
          }
        }
      }
    },
    "budget.week.lastDay %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is the last day of %@, so this is everything that's left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は%@の最終日なので、残りの全額です。"
          }
        }
      }
    },
    "budget.week.range %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@〜%2$@"
          }
        }
      }
    },
    "budget.week.subtitle %@": {
      "extractionState": "manual",
      "localizations": {
