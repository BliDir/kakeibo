# Firebase App Distribution settings for scripts/firebase-distribute.sh (docs/firebase-distribution.md).
# Not secrets: the App ID only identifies the app; uploading needs a logged-in Firebase CLI.
# Environment variables with the same names override these.
FIREBASE_PROJECT=kakeibo-87093
FIREBASE_APP_ID=1:357039095760:ios:1551a1f07d8686be1ac3d5
FIREBASE_GROUPS=blidir-team
# development: free Personal Team (owner's registered iPhone, build expires after 7 days).
# adhoc: paid Apple Developer Program (registered iPhones, about a year).
KAKEIBO_EXPORT=development
