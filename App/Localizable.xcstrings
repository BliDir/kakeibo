    "settings.alerts.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only spending you record in Kakeibo is counted. Lock-screen alerts never show amounts or store names, and iOS decides when they appear. Warnings inside the app always show, even with alerts off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakeiboに記録した支出だけが対象です。ロック画面の通知には金額や店名は表示されません。通知がいつ表示されるかはiOSが決めます。アプリ内の警告は、通知がオフでも常に表示されます。"
          }
        }
      }
    },
