    "budget.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only expenses you record are counted. Past months can't be edited."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録した支出だけを集計します。過去の月は編集できません。"
          }
        }
      }
    },
    "budget.over": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over"
