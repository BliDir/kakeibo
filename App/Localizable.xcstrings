    "budget.problem.notPositive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an amount above 0"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0より大きい金額を入力してください"
