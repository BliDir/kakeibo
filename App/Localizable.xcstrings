      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove budget"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算を削除"
          }
        }
      }
    },
    "budget.remove.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "budget.remove.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your receipts stay. Progress and alerts stop for this month."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートは残ります。この月の進み具合とアラートは止まります。"
          }
        }
      }
    },
    "budget.remove.title %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@'s budget?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の予算を削除しますか？"
          }
        }
      }
    },
    "budget.removeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't remove the budget. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算を削除できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "budget.save": {
      "extractionState": "manual",
      "localizations": {
